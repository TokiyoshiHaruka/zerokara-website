PORT=3000

# Host-side backend commands use this value. Docker Compose overrides it for the API container.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=zero_site
MYSQL_USER=zero_user
MYSQL_PASSWORD=change-me

JWT_SECRET=change-me-long-random-string
ZERO_ADMIN_USERNAME=admin
ZERO_ADMIN_DISPLAY_NAME=ZERO Admin
ZERO_ADMIN_PASSWORD=change-me-admin-password

NGINX_ACCESS_LOG=/var/log/nginx/access.log
